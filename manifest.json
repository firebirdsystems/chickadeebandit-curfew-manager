{
  "id": "curfew-manager",
  "contexts": ["household", "shared_space"],
  "name": "Curfew Manager",
  "version": "1.1.0",
  "description": "Adults set per-child curfew times by weekday and weekend. Kids see their schedule and can request one-time exceptions. Parents approve or deny in-app.",
  "entrypoint": "index.html",
  "runtime": "static",
  "category": "family",
  "tags": [
    "kids",
    "curfew",
    "parenting",
    "permissions",
    "schedule"
  ],
  "data_access": {
    "reads": [
      "family.members"
    ],
    "writes": []
  },
  "permissions": {
    "default_audience": "everyone",
    "requires_approval": false
  },
  "storage": "db",
  "db_plaintext_columns": ["date", "requested_time"],
  "agenda": {
    "kind": "reminder",
    "label": "Curfew",
    "source": {
      "kind": "sql",
      "query": "SELECT id AS id, 'Home by ' || requested_time AS title, date AS when_at, member_id AS member_id, NULLIF(reason, '') AS subtitle FROM app_curfew_manager__exception_requests WHERE date = :today AND status = 'approved' ORDER BY requested_time LIMIT 20"
    }
  },
  "row_policies": {
    "curfews": { "kind": "adult_writable" },
    "exception_requests": {
      "kind": "owner_only",
      "member_column": "member_id",
      "member_can_update": false,
      "retain_days": {
        "default": 365,
        "timestamp_column": "created_at",
        "override_key": "exception_history"
      }
    }
  },
  "member_references": {
    "curfews": {
      "column": "member_id",
      "on_removed": "delete",
      "id_column": "rowid"
    },
    "exception_requests": [
      {
        "column": "member_id",
        "on_removed": "delete"
      },
      {
        "column": "reviewed_by",
        "on_removed": "keep"
      }
    ]
  },
  "publishes": [
    "curfew.exception_requested",
    "curfew.exception_approved",
    "curfew.exception_denied"
  ],
  "alert_on": [
    "curfew.exception_requested",
    "curfew.exception_approved",
    "curfew.exception_denied"
  ],
  "publish_acls": {
    "curfew.exception_approved": { "require_role": "adult" },
    "curfew.exception_denied": { "require_role": "adult" }
  },
  "nav": { "label": "Curfew" },
  "resource_limits": {
    "max_db_bytes": 52428800
  },
  "icon": "🌙",
  "ai_access": {
    "allowed": true,
    "mode": "read",
    "db_exports": ["curfew_schedules", "pending_exceptions"]
  }
}
